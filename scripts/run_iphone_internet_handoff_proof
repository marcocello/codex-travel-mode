#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUTPUT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output)
      OUTPUT="${2:?--output requires a directory}"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$OUTPUT" ]]; then
  echo "Usage: $0 --output DIRECTORY" >&2
  exit 2
fi

mkdir -p "$OUTPUT"
READBACK="$OUTPUT/provider-readback.json"
STDOUT="$OUTPUT/worker.stdout.txt"
STDERR="$OUTPUT/worker.stderr.txt"

cd "$ROOT"
swift build --disable-sandbox --product iphone-internet-handoff-proof-worker
BIN_DIR="$(swift build --disable-sandbox --show-bin-path)"
WORKER="$BIN_DIR/iphone-internet-handoff-proof-worker"
if [[ ! -x "$WORKER" ]]; then
  echo "Missing proof worker executable: $WORKER" >&2
  exit 1
fi

"$WORKER" --output "$READBACK" >"$STDOUT" 2>"$STDERR" &
worker_pid=$!
set +e
wait "$worker_pid"
worker_status=$?
set -e
if [[ $worker_status -ne 0 ]]; then
  /bin/cat "$STDERR" >&2
  exit "$worker_status"
fi
if [[ ! -s "$READBACK" ]]; then
  echo "Proof worker did not write provider-readback.json." >&2
  exit 1
fi

jq -e --argjson pid "$worker_pid" '
  .schema_version == 1
  and .worker_pid == $pid
  and (.scenarios | type == "array" and length >= 23)
  and all(.scenarios[];
    (.name | type == "string" and length > 0)
    and (.entrypoint | type == "string" and length > 0)
    and (.events | type == "array" and length > 0)
    and (.provider_reads | type == "array")
    and (.commands | type == "array")
    and (.publications | type == "array" and length > 0)
    and (.reachability_calls | type == "array")
    and (.http_receipts | type == "array")
    and (.journal_snapshots | type == "array")
    and (.scheduler_sleeps | type == "array")
  )
' "$READBACK" >/dev/null

if ! jq -e '
  all(.scenarios[];
    all(.commands[];
      . as $command
      | if (
        (["session_manager_fake", "session_manager_real_proxy"] | index($command.source)) != null
        and (["wifi_power", "associate"] | index($command.operation)) != null
      ) then
        (.session_id | type == "string" and length > 0)
        and (.generation_id | type == "string" and length > 0)
        and (.episode_id | type == "string" and length > 0)
        and (.attempt | type == "number" and . >= 1 and . <= 3 and floor == .)
      else true end
    )
  )
' "$READBACK" >/dev/null; then
  echo "Episode mutation records are missing exact identity or bounded attempt data." >&2
  exit 1
fi

if jq -e '
  .. | objects |
  select(
    has("pass") or has("passed") or has("verdict") or has("checks")
    or has("assertions") or has("expected") or has("matches")
    or has("within_budget") or has("no_churn")
  )
' "$READBACK" >/dev/null; then
  echo "Raw provider read-back contains a forbidden self-attestation key." >&2
  exit 1
fi

if /usr/bin/grep -F -q 'proof-secret-sentinel' "$READBACK" "$STDOUT" "$STDERR"; then
  echo "The proof password sentinel escaped into captured evidence." >&2
  exit 1
fi

required_scenarios=(
  app_state_open_close_idempotent
  initially_closed_healthy_target
  partial_ssid_only
  partial_address_only
  partial_wrong_route
  partial_http_rejected
  provider_failure_is_not_disconnection
  wifi_power_enable_failure
  retry_exhaustion_explicit_retry
  closed_healthy_path_loss_single_recovery
  initial_open_disconnected_waits
  open_associated_to_disconnected_fallback
  exact_byte_ssid_identity
  reopen_cancels_close_episode_then_reclose
  stop_during_power
  stop_during_association
  stop_during_connectivity_read
  stop_during_probe
  stop_during_backoff
  transactional_power_order_and_restore
  cross_session_stop_cancellation
  episode_budget_exhaustion
  transactional_retry_reconciliation
)
for scenario in "${required_scenarios[@]}"; do
  if ! jq -e --arg scenario "$scenario" '.scenarios | any(.name == $scenario)' "$READBACK" >/dev/null; then
    echo "Missing proof scenario: $scenario" >&2
    exit 1
  fi
done

if ! jq -e '
  all(.scenarios[];
    ([
      .events[], .provider_reads[], .commands[], .publications[],
      .reachability_calls[], .http_receipts[], .journal_snapshots[], .scheduler_sleeps[]
    ] | map(.sequence)) as $sequences
    | ($sequences | length) == ($sequences | unique | length)
    and all($sequences[]; type == "number" and . > 0)
  )
' "$READBACK" >/dev/null; then
  echo "Scenario records do not have unique positive sequence numbers." >&2
  exit 1
fi

set +e
test_output="$({ PROOF_ARTIFACT_PATH="$READBACK" swift test --disable-sandbox --filter IPhoneInternetHandoffProofTests; } 2>&1)"
test_status=$?
set -e
printf '%s\n' "$test_output"
if [[ $test_status -ne 0 ]]; then
  exit "$test_status"
fi
if ! /usr/bin/grep -Eq 'Executed [1-9][0-9]* tests?|Test run with [1-9][0-9]* tests?' <<<"$test_output"; then
  echo "iPhone internet handoff proof filter executed zero tests." >&2
  exit 1
fi

echo "$READBACK"
